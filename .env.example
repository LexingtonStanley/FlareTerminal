# Copy to .env.local (git-ignored) and fill in. EXPO_PUBLIC_* values are bundled into
# the app, so they must be safe to publish: never put a secret or service-role key here.
# Supabase dashboard: Project Settings > API (URL) and API Keys (publishable key).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
