{
  "expo": {
    "name": "Flare Terminal",
    "slug": "flare-terminal",
    "owner": "lexingtonstanley",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/2a925f89-3574-4e44-8fe4-5b7f286e8367"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "flareterminal",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.lexingtonstanley.flareterminal",
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Flare Terminal connects to terminals running on computers on your local network."
      }
    },
    "android": {
      "package": "com.lexingtonstanley.flareterminal",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png"
        }
      ],
      "./plugins/with-background-sessions"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "2a925f89-3574-4e44-8fe4-5b7f286e8367"
      }
    }
  }
}
