  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "node scripts/gen-types.mjs && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "web:build": "expo export --platform web",
    "check:fast": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "check": "npm run check:fast && npm run test:e2e",
    "doctor": "npx expo-doctor",
    "build:preview": "npm install && npx eas-cli@latest build --profile preview --platform android",
    "update:preview": "APP_VARIANT=preview npx eas-cli@latest update --channel preview --environment preview",
    "rename": "node scripts/rename-app.mjs"
  },
